<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:Snipyard.Services"
             xmlns:local="clr-namespace:Snipyard"
             xmlns:ctl="clr-namespace:Snipyard.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Snipyard.AppShell"
             Background="{DynamicResource SurfaceBg}">

    <UserControl.Styles>
        <Style Selector="TextBox.snippet-text">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="TextBox.snippet-text:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="TextBox.snippet-text:focus">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
    </UserControl.Styles>

    <Grid>
    <DockPanel>
        <!-- Apple-style Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolBarBg}"
                Padding="16,10,16,5" BorderBrush="{DynamicResource DividerColor}"
                BorderThickness="0,0,0,0.5">
            <StackPanel Spacing="10">
                <!-- Row 1: Project + Row 2: Session -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="56,*,Auto">
                    <!-- Row 0: Project -->
                    <TextBlock x:Name="LblProject" Grid.Row="0" Grid.Column="0"
                               Text="Project" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource SubtleText}"
                               FontWeight="Normal" />

                    <Grid x:Name="ProjectRow" Grid.Row="0" Grid.Column="1"
                          ColumnDefinitions="*,Auto" Margin="10,0">
                    <ComboBox x:Name="CmbProjectFolder" Grid.Column="0"
                              Classes="modern"
                              IsEditable="True"
                              PlaceholderText="Select project folder..."
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnProjectFolderSelectionChanged"
                              KeyDown="OnProjectFolderKeyDown" />
                    <!-- Opens a project, the same act as the welcome page's New Project.
                         Sits beside the folder combo it fills in, matching the session row's
                         search button below it. -->
                    <Button x:Name="BtnNewProject" Grid.Column="1"
                            Classes="icon-btn" Padding="5" Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="New Project"
                            Click="OnActivityNewProject">
                        <PathIcon Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6ZM20 18H4V6H9.17L11.17 8H20V18ZM13 10H11V12H9V14H11V16H13V14H15V12H13V10Z"
                                  Width="13" Height="13" />
                    </Button>
                    </Grid>

                    <Button x:Name="BtnNewClaude" Grid.Row="0" Grid.Column="2"
                            Classes="primary"
                            ToolTip.Tip="Open a new session"
                            Click="OnNewClaude"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                        <TextBlock x:Name="LblNewClaude" Text="New Session"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuNewClaude" Opening="OnNewClaudeContextMenuOpening">
                                <MenuItem x:Name="MenuNewClaudeWorktreeToggle" Header="New Session (Worktree)"
                                          Click="OnNewClaudeWorktreeToggle" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Row 1: Session -->
                    <TextBlock x:Name="LblSession" Grid.Row="1" Grid.Column="0"
                               Text="Session" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource SubtleText}"
                               FontWeight="Normal" Margin="0,3,0,0" />

                    <Grid x:Name="SessionRow" Grid.Row="1" Grid.Column="1"
                          ColumnDefinitions="*,Auto" Margin="10,3,10,0">
                    <ComboBox x:Name="CmbSessions" Grid.Column="0"
                              Classes="modern"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select a session to resume..."
                              SelectionChanged="OnSessionSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:SessionInfo">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="#18007AFF" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{ReflectionBinding Timestamp, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}"
                                                   FontSize="11" Foreground="{DynamicResource AccentText}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{ReflectionBinding DisplayTitle}" FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               MaxWidth="400" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- The combo lists every session this project has - 88 of them here - so
                         finding one, or clearing one out, needs a list you can search. -->
                    <Button x:Name="BtnManageSessions" Grid.Column="1"
                            Classes="icon-btn" Padding="5" Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Click="OnManageSessions">
                        <PathIcon Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z"
                                  Width="13" Height="13" />
                    </Button>
                    </Grid>

                    <Button x:Name="BtnResumeSession" Grid.Row="1" Grid.Column="2"
                            Classes="primary"
                            ToolTip.Tip="Resume selected session"
                            Click="OnResumeSession"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,3,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M8 5V19L19 12L8 5Z" Width="11" Height="11"
                                      Foreground="White" />
                            <TextBlock x:Name="LblResume" Text="Resume" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Apple-style Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBg}"
                Padding="16,6" BorderBrush="{DynamicResource DividerColor}"
                BorderThickness="0,0.5,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <!-- Clips rather than overlaps: the readouts grow with the session (mode, model,
                 effort, three meters, cost, activity) and on a narrow window the row would
                 otherwise run straight over the provider selector on its right. -->
            <Border Grid.Column="0" ClipToBounds="True" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Git repo icon + name -->
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
                              Width="14" Height="14" Foreground="{DynamicResource SubtleText}" />
                    <TextBlock x:Name="StatusRepoName" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" Cursor="Hand"
                               DoubleTapped="OnRepoNameDoubleTapped" />
                    <!-- Shown only when the project folder is not a git repository yet - lets
                         the user create or clone one right from the status bar. -->
                    <Button x:Name="BtnRepoActions" IsVisible="False"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip.Tip="Create or clone a repository"
                            Click="OnRepoActions">
                        <PathIcon Data="M7 10L12 15L17 10Z" Width="8" Height="8"
                                  Foreground="{DynamicResource SubtleText}" />
                    </Button>
                </StackPanel>
                <!-- Git branch icon + name -->
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="M6 3C4.34 3 3 4.34 3 6C3 7.31 3.84 8.41 5 8.83V15.17C3.84 15.59 3 16.69 3 18C3 19.66 4.34 21 6 21C7.66 21 9 19.66 9 18C9 16.69 8.16 15.59 7 15.17V8.83C8.16 8.41 9 7.31 9 6C9 4.34 7.66 3 6 3ZM6 5C6.55 5 7 5.45 7 6C7 6.55 6.55 7 6 7C5.45 7 5 6.55 5 6C5 5.45 5.45 5 6 5ZM6 17C6.55 17 7 17.45 7 18C7 18.55 6.55 19 6 19C5.45 19 5 18.55 5 18C5 17.45 5.45 17 6 17ZM18 3C16.34 3 15 4.34 15 6C15 7.31 15.84 8.41 17 8.83V12C17 13.1 16.1 14 15 14H13V12L9 16L13 20V18H15C18.31 18 19 15.31 19 12V8.83C20.16 8.41 21 7.31 21 6C21 4.34 19.66 3 18 3ZM18 5C18.55 5 19 5.45 19 6C19 6.55 18.55 7 18 7C17.45 7 17 6.55 17 6C17 5.45 17.45 5 18 5Z"
                              Width="14" Height="14" Foreground="{DynamicResource SubtleText}" />
                    <TextBlock x:Name="StatusBranchName" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" Cursor="Hand"
                               ToolTip.Tip="Current branch - double-click for the commit graph"
                               DoubleTapped="OnBranchNameDoubleTapped" />
                    <!-- Its own control rather than a click on the name: the name already
                         answers to a double-click, and a menu opening under every first click
                         would make reaching the commit graph a fight. -->
                    <Button x:Name="BtnBranchSwitch" IsVisible="False"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Cursor="Hand" VerticalAlignment="Center"
                            Click="OnBranchSwitch">
                        <PathIcon Data="M7 10L12 15L17 10Z" Width="8" Height="8"
                                  Foreground="{DynamicResource SubtleText}" />
                    </Button>
                </StackPanel>
                <!-- Separator -->
                <Border Width="1" Height="12" Background="{DynamicResource DividerColor}" />
                <!-- Which mode the AI is in (normal / accept edits / plan) -->
                <Border x:Name="StatusModeBadge" IsVisible="False"
                        CornerRadius="4" Padding="6,1" Cursor="Hand"
                        BorderThickness="1" VerticalAlignment="Center"
                        ToolTip.Tip="Current mode - click to cycle (Shift+Tab)"
                        PointerPressed="OnModeBadgePressed">
                    <TextBlock x:Name="StatusModeText" Text="" FontSize="10"
                               FontWeight="Medium" VerticalAlignment="Center" />
                </Border>
                <!-- Model answering in this session - click to switch -->
                <Button x:Name="StatusModelName" IsVisible="False"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock x:Name="StatusModelText" Text=""
                                   Foreground="{DynamicResource SubtleText}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <PathIcon Data="M7 10L12 15L17 10Z" Width="8" Height="8"
                                  Foreground="{DynamicResource SubtleText}" />
                    </StackPanel>
                </Button>
                <!-- Reasoning effort this session runs at - click to switch -->
                <Button x:Name="StatusEffortName" IsVisible="False"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock x:Name="StatusEffortText" Text=""
                                   Foreground="{DynamicResource SubtleText}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <PathIcon Data="M7 10L12 15L17 10Z" Width="8" Height="8"
                                  Foreground="{DynamicResource SubtleText}" />
                    </StackPanel>
                </Button>
                <!-- Rate limit: the 5-hour window -->
                <StackPanel x:Name="StatusFiveHourPanel" Orientation="Horizontal" Spacing="5"
                            IsVisible="False" VerticalAlignment="Center">
                    <TextBlock Text="5h"
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                    <Border Width="48" Height="6" CornerRadius="3" Background="#30FFFFFF"
                            VerticalAlignment="Center">
                        <Border x:Name="StatusFiveHourFill" Height="6" CornerRadius="3"
                                Background="#30D158" HorizontalAlignment="Left" Width="0" />
                    </Border>
                    <TextBlock x:Name="StatusFiveHourText" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- Rate limit: the 7-day window -->
                <StackPanel x:Name="StatusSevenDayPanel" Orientation="Horizontal" Spacing="5"
                            IsVisible="False" VerticalAlignment="Center">
                    <TextBlock Text="7d"
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                    <Border Width="48" Height="6" CornerRadius="3" Background="#30FFFFFF"
                            VerticalAlignment="Center">
                        <Border x:Name="StatusSevenDayFill" Height="6" CornerRadius="3"
                                Background="#30D158" HorizontalAlignment="Left" Width="0" />
                    </Border>
                    <TextBlock x:Name="StatusSevenDayText" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- Context used before auto-compact. Last of the three meters, so the one that
                     moves on every turn sits at the end of the row rather than in the middle. -->
                <StackPanel x:Name="StatusContextPanel" Orientation="Horizontal" Spacing="5"
                            IsVisible="False" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip.Tip="Context used before auto-compact - click to run /compact"
                            PointerPressed="OnContextMeterPressed">
                    <TextBlock x:Name="StatusContextLabel" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                    <Border Width="48" Height="6" CornerRadius="3" Background="#30FFFFFF"
                            VerticalAlignment="Center">
                        <Border x:Name="StatusContextFill" Height="6" CornerRadius="3"
                                Background="#30D158" HorizontalAlignment="Left" Width="0" />
                    </Border>
                    <TextBlock x:Name="StatusContextText" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- The activity readout comes and goes mid-session, so it sits at the end of
                     the row: a turn starting or ending never shifts the badges and meters to
                     its left. Stop lives on the input row of the window that is working. -->
                <Border x:Name="StatusRunSeparator" Width="1" Height="12" IsVisible="False"
                        Background="{DynamicResource DividerColor}" />
                <TextBlock x:Name="StatusActivityText" Text="" IsVisible="False"
                           Foreground="{DynamicResource SubtleText}" FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
            </Border>

            <!-- Active AI provider + switcher -->
            <Button x:Name="BtnAiSelector" Grid.Column="1"
                    Background="Transparent" BorderThickness="0"
                    Padding="8,1" Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Switch AI provider">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon x:Name="IconAiSelector"
                              Data="M12 2L14 9L21 11L14 13L12 20L10 13L3 11L10 9Z"
                              Width="11" Height="11"
                              Foreground="{DynamicResource SubtleText}" />
                    <TextBlock x:Name="LblAiSelector" Text=""
                               Foreground="{DynamicResource SubtleText}" FontSize="11"
                               VerticalAlignment="Center" />
                    <PathIcon Data="M7 10L12 15L17 10Z" Width="9" Height="9"
                              Foreground="{DynamicResource SubtleText}" />
                </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Main Area: ActivityBar | SidePanel | Splitter | RightArea(WindowStrip + MDI) -->
        <Grid x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Activity Bar (full height) -->
            <Border Grid.Column="0" Background="{DynamicResource ActivityBarBg}"
                    BorderBrush="{DynamicResource DividerColor}" BorderThickness="0,0,0.5,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,8">
                        <Button x:Name="BtnActivityExplorer" Classes="activity-btn"
                                ToolTip.Tip="Explorer (Ctrl+Shift+E)"
                                Click="OnActivityExplorer">
                            <PathIcon Data="M17.5 0H8.5L7 1.5V6H2.5L1 7.5V22.57L2.5 24H13.5L15 22.57V18H19.5L21 16.5V3.5L17.5 0ZM13.5 22.57H2.5V7.5H7V16.5L8.5 18H13.5V22.57ZM19.5 16.5H8.5V1.5H14.5V5.5H19.5V16.5ZM15.5 1.5L19.5 4.5H15.5V1.5Z"
                                      Width="20" Height="20" />
                        </Button>
                        <!-- The badge sits beside the button, not inside it: the button is dimmed while
                             another panel is up, and a count of unpulled commits must not be. -->
                        <Panel>
                            <Button x:Name="BtnActivitySourceControl" Classes="activity-btn"
                                    ToolTip.Tip="Source control (Ctrl+Shift+G)"
                                    Click="OnActivitySourceControl">
                                <PathIcon Data="M21.007 8.222A3.738 3.738 0 0 0 15.045 5.2a3.737 3.737 0 0 0 1.156 6.583 2.988 2.988 0 0 1-2.668 1.67h-2.99a4.456 4.456 0 0 0-2.989 1.165V7.4a3.737 3.737 0 1 0-1.494 0v9.117a3.776 3.776 0 1 0 1.816.099 2.99 2.99 0 0 1 2.668-1.667h2.99a4.484 4.484 0 0 0 4.223-3.039 3.736 3.736 0 0 0 3.25-3.687zM4.565 3.738a2.242 2.242 0 1 1 4.484 0 2.242 2.242 0 0 1-4.484 0zm4.484 16.441a2.242 2.242 0 1 1-4.484 0 2.242 2.242 0 0 1 4.484 0zm8.221-9.715a2.242 2.242 0 1 1 0-4.485 2.242 2.242 0 0 1 0 4.485z"
                                          Width="20" Height="20" />
                            </Button>
                            <!-- Same box as Button.activity-btn, so the badge can be placed against the icon. Anchored
                                 by its right edge: a longer count grows over the icon, not past the bar. -->
                            <Panel Width="48" Height="40" Margin="4,1" IsHitTestVisible="False">
                                <Border x:Name="SourceControlBadge" IsVisible="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,20" MinWidth="16" Height="16" Padding="4,0"
                                        CornerRadius="8" Background="#FF3B30"
                                        BorderBrush="{DynamicResource ActivityBarBg}" BorderThickness="1.5">
                                    <TextBlock x:Name="SourceControlBadgeText" Text="0"
                                               FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                        </Panel>
                        <Button x:Name="BtnActivityWindows" Classes="activity-btn"
                                ToolTip.Tip="Windows"
                                Click="OnActivityWindows">
                            <PathIcon Data="M3 3H21V10H3ZM3 14H21V21H3Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivityDocView" Classes="activity-btn"
                                ToolTip.Tip="Chat View"
                                Click="OnActivityDocView">
                            <PathIcon Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2ZM20 16H6L4 18V4H20V16ZM7 9H9V11H7V9ZM11 9H13V11H11V9ZM15 9H17V11H15V9Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivitySnippets" Classes="activity-btn"
                                ToolTip.Tip="Snippets"
                                Click="OnActivitySnippets">
                            <PathIcon Data="M4 2H14L20 8V22H4V2ZM6 4V20H18V9H13V4H6ZM7 12H17V14H7V12ZM7 16H14V18H7V16Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivitySlash" Classes="activity-btn"
                                ToolTip.Tip="Slash commands (Ctrl+/)"
                                Click="OnActivitySlashCommands">
                            <PathIcon Data="M3 3H21V21H3V3M5 5V19H19V5H5M7.5 8.5L10.5 11.5L7.5 14.5L8.9 15.9L13.3 11.5L8.9 7.1L7.5 8.5M12.5 15H17V17H12.5V15Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivityExtensions" Classes="activity-btn"
                                ToolTip.Tip="MCP, skills and plugins"
                                Click="OnActivityExtensions">
                            <PathIcon Data="M20.5 11H19V7C19 5.9 18.1 5 17 5H13V3.5C13 2.12 11.88 1 10.5 1C9.12 1 8 2.12 8 3.5V5H4C2.9 5 2.01 5.9 2.01 7V10.8H3.5C4.99 10.8 6.2 12.01 6.2 13.5C6.2 14.99 4.99 16.2 3.5 16.2H2V20C2 21.1 2.9 22 4 22H7.8V20.5C7.8 19.01 9.01 17.8 10.5 17.8C11.99 17.8 13.2 19.01 13.2 20.5V22H17C18.1 22 19 21.1 19 20V16H20.5C21.88 16 23 14.88 23 13.5C23 12.12 21.88 11 20.5 11Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivityMemory" Classes="activity-btn"
                                ToolTip.Tip="Memory (Ctrl+Shift+M)"
                                Click="OnActivityMemory">
                            <PathIcon Data="M15 9H9V15H15V9M13 11V13H11V11H13M21 11V9H19V7A2 2 0 0 0 17 5H15V3H13V5H11V3H9V5H7A2 2 0 0 0 5 7V9H3V11H5V13H3V15H5V17A2 2 0 0 0 7 19H9V21H11V19H13V21H15V19H17A2 2 0 0 0 19 17V15H21V13H19V11H21M17 17H7V7H17V17Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivityDiagram" Classes="activity-btn"
                                ToolTip.Tip="Diagram Viewer"
                                IsVisible="False"
                                Click="OnActivityDiagram">
                            <PathIcon Data="M4 4H10V10H4ZM14 4H20V10H14ZM4 14H10V20H4ZM14 17L17 14L20 17L17 20Z"
                                      Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"
                                Spacing="2" Margin="0,8">
                        <Button x:Name="BtnActivityCompact" Classes="activity-btn"
                                ToolTip.Tip="Compact (/compact)"
                                Click="OnActivityCompact">
                            <PathIcon Data="M4 1H20V3H4Z M6 4L18 8L6 12L12 12L22 8L12 4Z M2 12L14 16L2 20L8 20L18 16L8 12Z M4 21H20V23H4Z M10 3H14L12 5Z M10 21L12 19L14 21Z"
                                      Width="22" Height="22" />
                        </Button>
                        <Button x:Name="BtnActivityCost" Classes="activity-btn"
                                ToolTip.Tip="Tokens &amp; cost"
                                Click="OnActivityCost">
                            <PathIcon Data="M4 20H20V22H4ZM4 2H6V18H4ZM8 12H11V18H8ZM13 8H16V18H13ZM18 4H21V18H18Z"
                                      Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BtnActivitySettings" Classes="activity-btn"
                                ToolTip.Tip="Settings"
                                Click="OnActivitySettings">
                            <PathIcon Data="M12 15.5A3.5 3.5 0 0 1 8.5 12A3.5 3.5 0 0 1 12 8.5A3.5 3.5 0 0 1 15.5 12A3.5 3.5 0 0 1 12 15.5M19.43 12.97C19.47 12.65 19.5 12.33 19.5 12C19.5 11.67 19.47 11.34 19.43 11L21.54 9.37C21.73 9.22 21.78 8.95 21.66 8.73L19.66 5.27C19.54 5.05 19.27 4.96 19.05 5.05L16.56 6.05C16.04 5.66 15.5 5.32 14.87 5.07L14.5 2.42C14.46 2.18 14.25 2 14 2H10C9.75 2 9.54 2.18 9.5 2.42L9.13 5.07C8.5 5.32 7.96 5.66 7.44 6.05L4.95 5.05C4.73 4.96 4.46 5.05 4.34 5.27L2.34 8.73C2.21 8.95 2.27 9.22 2.46 9.37L4.57 11C4.53 11.34 4.5 11.67 4.5 12C4.5 12.33 4.53 12.65 4.57 12.97L2.46 14.63C2.27 14.78 2.21 15.05 2.34 15.27L4.34 18.73C4.46 18.95 4.73 19.04 4.95 18.95L7.44 17.94C7.96 18.34 8.5 18.68 9.13 18.93L9.5 21.58C9.54 21.82 9.75 22 10 22H14C14.25 22 14.46 21.82 14.5 21.58L14.87 18.93C15.5 18.67 16.04 18.34 16.56 17.94L19.05 18.95C19.27 19.04 19.54 18.95 19.66 18.73L21.66 15.27C21.78 15.05 21.73 14.78 21.54 14.63L19.43 12.97Z"
                                      Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                    <Border />
                </DockPanel>
            </Border>

            <!-- Side Panel (full height, next to Activity Bar) -->
            <Border Grid.Column="1" x:Name="SidePanel" Background="{DynamicResource SidePanelBg}"
                    BorderBrush="{DynamicResource DividerColor}" BorderThickness="0,0,0.5,0"
                    ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,10"
                            BorderBrush="{DynamicResource DividerColor}" BorderThickness="0,0,0,0.5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="SidePanelTitle" Text="EXPLORER"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource SubtleText}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnBrowseFolder" Grid.Column="1"
                                    Classes="icon-btn"
                                    ToolTip.Tip="Browse folder..."
                                    Click="OnBrowseFolder"
                                    Padding="4" Margin="0,-4,0,-4">
                                <PathIcon Data="M2 6C2 4.89543 2.89543 4 4 4H9L11 6H18C19.1046 6 20 6.89543 20 8V16C20 17.1046 19.1046 18 18 18H4C2.89543 18 2 17.1046 2 16V6Z"
                                          Width="13" Height="13" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid>
                        <!-- Explorer Panel -->
                        <DockPanel x:Name="ExplorerPanel">
                            <TreeView x:Name="FileTree"
                                      Background="Transparent"
                                      Margin="0,4"
                                      SelectionMode="Multiple"
                                      DoubleTapped="OnTreeItemDoubleTapped">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuTreeOpen" Header="Open" Click="OnTreeOpenDefault">
                                            <MenuItem.Icon>
                                                <PathIcon Data="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2ZM18 20H6V4H13V9H18V20Z"
                                                          Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MenuTreeOpenWith" Header="Open with..." Click="OnTreeOpenWith">
                                            <MenuItem.Icon>
                                                <PathIcon Data="M19 19H5V5H12V3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V12H19V19ZM14 3V5H17.59L7.76 14.83L9.17 16.24L19 6.41V10H21V3H14Z"
                                                          Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MenuTreeOpenInEditor" Header="Open in Editor" Click="OnTreeOpenInEditor">
                                            <MenuItem.Icon>
                                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                          Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="MenuTreeShowInExplorer" Header="Show in Explorer" Click="OnTreeShowInExplorer">
                                            <MenuItem.Icon>
                                                <PathIcon Data="M2 6C2 4.89543 2.89543 4 4 4H9L11 6H18C19.1046 6 20 6.89543 20 8V16C20 17.1046 19.1046 18 18 18H4C2.89543 18 2 17.1046 2 16V6Z"
                                                          Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MenuTreeCopyPath" Header="Copy Path" Click="OnTreeCopyPath">
                                            <MenuItem.Icon>
                                                <PathIcon Data="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"
                                                          Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MenuTreeCopyFilename" Header="Copy Filename" Click="OnTreeCopyFilename">
                                            <MenuItem.Icon>
                                                <PathIcon Data="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2ZM16 18H8V16H16V18ZM16 14H8V12H16V14ZM13 9V3.5L18.5 9H13Z"
                                                          Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="MinHeight" Value="22" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,-1,0,-1" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="local:FileTreeNode"
                                                      ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Background="Transparent">
                                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                <Image Source="{Binding ShellIcon}"
                                                       Width="16" Height="16"
                                                       IsVisible="{Binding HasShellIcon}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                <PathIcon Data="{Binding IconData}" Width="14" Height="14"
                                                          Foreground="{Binding IconColor}"
                                                          IsVisible="{Binding HasGlyphIcon}" />
                                            </Panel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>

                        <!-- Settings Panel -->
                        <ScrollViewer x:Name="SettingsPanel" IsVisible="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="20" Margin="14,16">
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="14">
                                        <TextBlock x:Name="LblConsoleSettings" Text="Console Settings" Classes="settings-group-header" />
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblLanguage" Text="Language" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <ComboBox x:Name="CmbSettingsLanguage" Classes="modern"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblFontFamily" Text="Font Family" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <ComboBox x:Name="CmbSettingsFontFamily" Classes="modern"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblFontSize" Text="Font Size" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <NumericUpDown x:Name="NumSettingsFontSize"
                                                           Minimum="8" Maximum="32" Increment="1"
                                                           FormatString="0"
                                                           HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblTerminalShell" Text="Host Shell" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <ComboBox x:Name="CmbTerminalShell" Classes="modern"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnTerminalShellSelectionChanged" />
                                            <TextBlock x:Name="LblTerminalShellHint" Text="" FontSize="11"
                                                       TextWrapping="Wrap" Opacity="0.75"
                                                       Foreground="{DynamicResource SubtleText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkDarkMode" Content="Dark Mode"
                                                  Margin="0,4,0,4"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnDarkModeChanged" />
                                        <Button x:Name="BtnApplySettings" Classes="primary"
                                                HorizontalAlignment="Stretch"
                                                Click="OnApplySettings"
                                                Margin="0,4,0,0">
                                            <TextBlock x:Name="LblApplySettings" Text="Apply"
                                                       HorizontalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="LblGeneralSettings" Text="General" Classes="settings-group-header" />
                                        <CheckBox x:Name="ChkShowWelcomePage" Content="Show Welcome Page"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnShowWelcomePageChanged" />
                                        <CheckBox x:Name="ChkEnableCharts" Content="Render diagrams in the terminal"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnEnableChartsChanged" />
                                        <!-- Shell icons are on by default and the switch is kept out of the
                                             panel; set IsVisible="True" to offer it again. -->
                                        <CheckBox x:Name="ChkUseShellIcons" Content="Use Windows Explorer icons in the file tree"
                                                  IsVisible="False"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnUseShellIconsChanged" />
                                    </StackPanel>
                                </Border>
                                <!-- Worktree and the context profile picker used to sit in the top
                                     toolbar; they moved here so the toolbar stays focused on
                                     picking a project/session. -->
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="LblSessionLaunch" Text="Session Launch" Classes="settings-group-header" />
                                        <CheckBox x:Name="ChkWorktree" IsVisible="False"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnWorktreeChanged">
                                            <TextBlock x:Name="LblWorktree" Text="Worktree"
                                                       VerticalAlignment="Center" />
                                        </CheckBox>
                                        <StackPanel x:Name="LaunchProfileRow" Spacing="6"
                                                    IsVisible="False">
                                            <TextBlock x:Name="LblLaunchProfile" Text="Profile" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <ComboBox x:Name="CmbLaunchProfile" Classes="modern"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnLaunchProfileChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="ModelEffortOverrideRow" Spacing="6"
                                                    IsVisible="False">
                                            <TextBlock x:Name="LblPreferredModel" Text="Model" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <ComboBox x:Name="CmbPreferredModel" Classes="modern"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnPreferredModelChanged" />
                                            <TextBlock x:Name="LblPreferredEffort" Text="Effort" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <ComboBox x:Name="CmbPreferredEffort" Classes="modern"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnPreferredEffortChanged" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblInitialPrompt" Text="Initial Prompt" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <TextBox x:Name="TxtInitialPrompt"
                                                     HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="LblHelpAndDiagnostics" Text="Help &amp; Diagnostics" Classes="settings-group-header" />
                                        <Grid ColumnDefinitions="*,8,*">
                                            <Button x:Name="BtnSetupDoctor" Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Check that everything is installed and signed in"
                                                    Click="OnSetupDoctor">
                                                <TextBlock x:Name="LblSetupDoctor" Text="Setup Check" FontSize="12" />
                                            </Button>
                                            <Button x:Name="BtnShortcuts" Grid.Column="2"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Keyboard shortcuts (F1)"
                                                    Click="OnShowShortcuts">
                                                <TextBlock x:Name="LblShortcuts" Text="Keyboard Shortcuts" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="LblNotifications" Text="Notifications" Classes="settings-group-header" />
                                        <CheckBox x:Name="ChkNotifyOnComplete" Content="Notify when a task finishes"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnNotifySettingChanged" />
                                        <CheckBox x:Name="ChkNotifySound" Content="Play a sound"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnNotifySettingChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="LblUpdates" Text="Updates" Classes="settings-group-header" />
                                        <CheckBox x:Name="ChkCheckUpdate" Content="Check for updates at startup"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnCheckUpdateSettingChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="LblCheckpoints" Text="Checkpoints" Classes="settings-group-header" />
                                        <CheckBox x:Name="ChkEnableCheckpoints" Content="Snapshot the project before each prompt"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnEnableCheckpointsChanged" />
                                        <Button x:Name="BtnOpenCheckpoints" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" Margin="0,4,0,0"
                                                Click="OnShowCheckpoints">
                                            <TextBlock x:Name="LblOpenCheckpoints" Text="Checkpoints" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="LblLiveStatus" Text="Live status" Classes="settings-group-header" />
                                        <CheckBox x:Name="ChkEnableLiveStatus" Content="Show mode, activity and context left"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnLiveStatusSettingChanged" />
                                        <CheckBox x:Name="ChkEnableErrorBanner" Content="Explain errors in a banner"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnLiveStatusSettingChanged" />
                                        <CheckBox x:Name="ChkCacheExpiryGuard" Content="Confirm before sending after the cache expires"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnLiveStatusSettingChanged" />
                                        <CheckBox x:Name="ChkRateLimitStatusLine" Content="Get rate limits from Claude Code (adds a status line)"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnLiveStatusSettingChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="LblSourceControlSettings" Text="Source control" Classes="settings-group-header" />
                                        <TextBlock x:Name="LblCommitLanguage" Text="Commit message language" FontSize="12"
                                                   Foreground="{DynamicResource SubtleText}" />
                                        <ComboBox x:Name="CmbCommitLanguage" HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnCommitLanguageChanged" />
                                        <CheckBox x:Name="ChkGitAutoFetch" Content="Fetch from the remote every 5 minutes"
                                                  Foreground="{DynamicResource SubtleText}"
                                                  IsCheckedChanged="OnGitAutoFetchChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="LblPlanTier" Text="Plan" Classes="settings-group-header" />
                                        <ComboBox x:Name="CmbPlanTier" HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnPlanTierChanged" />
                                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
                                            <Button x:Name="BtnOpenCostDashboard" Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="OnActivityCost">
                                                <TextBlock x:Name="LblOpenCostDashboard" Text="Tokens &amp; cost" FontSize="12" />
                                            </Button>
                                            <Button x:Name="BtnOpenUsageChart" Grid.Column="2"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="OnShowUsageChart">
                                                <TextBlock x:Name="LblOpenUsageChart" Text="Usage Chart" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Provider -->
                                <Border Classes="settings-group">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="LblAiProvider" Text="AI Provider" Classes="settings-group-header" />
                                        <StackPanel x:Name="PnlProviderRadios" Spacing="2" />
                                        <!-- Opens the active provider's own config directory (e.g. Claude
                                             Code's .claude folder) - distinct from Open Config Folder
                                             below, which opens Snipyard's provider-definition folder. -->
                                        <Button x:Name="BtnOpenClaudeFolder" Classes="primary"
                                                HorizontalAlignment="Stretch"
                                                Click="OnOpenClaudeFolder">
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        HorizontalAlignment="Center">
                                                <PathIcon Data="M2 6C2 4.89543 2.89543 4 4 4H9L11 6H18C19.1046 6 20 6.89543 20 8V16C20 17.1046 19.1046 18 18 18H4C2.89543 18 2 17.1046 2 16V6Z"
                                                          Width="12" Height="12" Foreground="White" />
                                                <TextBlock x:Name="LblOpenClaudeFolder" Text="Open .claude Folder" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblProviderExe" Text="Executable" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <TextBox x:Name="TxtProviderExe" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblProviderNewArgs" Text="New Session Args" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <TextBox x:Name="TxtProviderNewArgs" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblProviderContinueArgs" Text="Continue Args" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <TextBox x:Name="TxtProviderContinueArgs" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="LblProviderResumeArgs" Text="Resume Args" FontSize="13"
                                                       Foreground="{DynamicResource SubtleText}" />
                                            <TextBox x:Name="TxtProviderResumeArgs" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
                                            <Button x:Name="BtnRestoreProviderDefaults" Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="OnRestoreProviderDefaults">
                                                <TextBlock x:Name="LblRestoreDefaults" Text="Restore Defaults" FontSize="12" />
                                            </Button>
                                            <Button x:Name="BtnOpenProviderConfig" Grid.Column="2"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="OnOpenProviderConfigFolder">
                                                <TextBlock x:Name="LblOpenConfigFolder" Text="Open Config Folder" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Snippets Panel -->
                        <DockPanel x:Name="SnippetsPanel" IsVisible="False">
                            <Button x:Name="BtnAddSnippet" DockPanel.Dock="Bottom"
                                    Classes="primary" HorizontalAlignment="Stretch"
                                    Margin="10,8" Click="OnAddSnippet">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center">
                                    <PathIcon Data="M11 4H13V11H20V13H13V20H11V13H4V11H11Z" Width="12" Height="12"
                                              Foreground="White" />
                                    <TextBlock x:Name="LblAddSnippet" Text="Add Snippet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SnippetsList" Spacing="3"
                                            Margin="5,8" />
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Source Control Panel — built in code, see Controls/SourceControlPanel.cs -->
                        <ContentControl x:Name="SourceControlHost" IsVisible="False" />

                        <!-- Memory Panel — built in code, see Controls/MemoryPanel.cs -->
                        <ContentControl x:Name="MemoryHost" IsVisible="False" />

                        <!-- Windows Panel -->
                        <ScrollViewer x:Name="WindowsPanel" IsVisible="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WindowsList" Spacing="2" Margin="4,8" />
                        </ScrollViewer>

                        <!-- Slash Commands Panel -->
                        <DockPanel x:Name="SlashPanel" IsVisible="False">
                            <TextBox x:Name="TxtSlashSearch" DockPanel.Dock="Top"
                                     FontSize="12" Padding="8,5" Margin="8,8,8,0"
                                     CornerRadius="4"
                                     TextChanged="OnSlashSearchChanged"
                                     KeyDown="OnSlashSearchKeyDown" />
                            <TextBlock x:Name="LblSlashHint" DockPanel.Dock="Bottom"
                                       Text="" FontSize="10" TextWrapping="Wrap"
                                       Margin="10,4,10,8"
                                       Foreground="{DynamicResource SubtleText}" />
                            <ListBox x:Name="SlashList" Background="Transparent"
                                     Margin="4,4,4,0"
                                     KeyDown="OnSlashListKeyDown"
                                     DoubleTapped="OnSlashListDoubleTapped" />
                        </DockPanel>

                        <!-- Extensions Panel: MCP servers, skills and plugins -->
                        <DockPanel x:Name="ExtensionsPanel" IsVisible="False">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
                                  Margin="8,8,8,0">
                                <TextBox x:Name="TxtExtensionSearch" Grid.Column="0"
                                         FontSize="12" Padding="8,5"
                                         CornerRadius="4"
                                         TextChanged="OnExtensionSearchChanged" />
                                <Button x:Name="BtnRefreshExtensions" Grid.Column="1"
                                        Classes="icon-btn" Padding="4" Margin="4,0,0,0"
                                        ToolTip.Tip="Refresh" Click="OnRefreshExtensions">
                                    <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4C7.58 4 4 7.58 4 12C4 16.42 7.58 20 12 20C15.73 20 18.84 17.45 19.73 14H17.65C16.83 16.33 14.61 18 12 18C8.69 18 6 15.31 6 12C6 8.69 8.69 6 12 6C13.66 6 15.14 6.69 16.22 7.78L13 11H20V4L17.65 6.35Z"
                                              Width="13" Height="13" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="LblExtensionsHint" DockPanel.Dock="Bottom"
                                       Text="" FontSize="10" TextWrapping="Wrap"
                                       Margin="10,4,10,8"
                                       Foreground="{DynamicResource SubtleText}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ExtensionsList" Spacing="1" Margin="4,6" />
                            </ScrollViewer>
                        </DockPanel>

                    </Grid>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="2" x:Name="PanelSplitter"
                          Width="4" Background="Transparent"
                          IsVisible="False" />

            <!-- Right Area: WindowStrip (top) + MDI (fill) -->
            <DockPanel Grid.Column="3">
                <!-- Horizontal Window Strip -->
                <!-- The bottom padding is 0 and the tabs carry an 8px bottom margin instead: that
                     is the lane the horizontal scrollbar is drawn in, since Avalonia puts it over
                     the content. Both columns reserve it so the layout buttons stay level. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource ToolBarBg}" Padding="6,4,6,0"
                        BorderBrush="{DynamicResource DividerColor}" BorderThickness="0,0,0,0.5">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer x:Name="WindowStripScroll" Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="WindowStrip" Orientation="Horizontal" Spacing="4"
                                        Margin="0,0,0,8" />
                        </ScrollViewer>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                    Margin="8,0,0,8">
                            <Border Width="1" Background="{DynamicResource DividerColor}" Margin="0,4" />
                            <Button x:Name="BtnLayoutTile" Classes="icon-btn"
                                    ToolTip.Tip="Tile windows"
                                    Click="OnLayoutTile">
                                <PathIcon Data="M3 3H10V10H3ZM14 3H21V10H14ZM3 14H10V21H3ZM14 14H21V21H14Z"
                                          Width="14" Height="14" />
                            </Button>
                            <Button x:Name="BtnLayoutTileH" Classes="icon-btn"
                                    ToolTip.Tip="Tile horizontally"
                                    Click="OnLayoutTileH">
                                <PathIcon Data="M3 3H21V10H3ZM3 14H21V21H3Z"
                                          Width="14" Height="14" />
                            </Button>
                            <Button x:Name="BtnLayoutTileV" Classes="icon-btn"
                                    ToolTip.Tip="Tile vertically"
                                    Click="OnLayoutTileV">
                                <PathIcon Data="M3 3H10V21H3ZM14 3H21V21H14Z"
                                          Width="14" Height="14" />
                            </Button>
                            <Button x:Name="BtnLayoutMaximize" Classes="icon-btn"
                                    ToolTip.Tip="Full view"
                                    Click="OnLayoutMaximize">
                                <PathIcon Data="M3 3H21V21H3ZM5 5V19H19V5Z"
                                          Width="14" Height="14" />
                            </Button>
                            <Border Width="1" Background="{DynamicResource DividerColor}" Margin="0,4" />
                            <!-- Saved layouts belong with the layout buttons, not buried in the
                                 command palette: restoring one is the same kind of act. -->
                            <Button x:Name="BtnWorkspaces" Classes="icon-btn"
                                    ToolTip.Tip="Workspaces"
                                    Click="OnShowWorkspaces">
                                <PathIcon Data="M4 3H17L20 6V20C20 20.55 19.55 21 19 21H5C4.45 21 4 20.55 4 20V4C4 3.45 4.45 3 5 3ZM7 3V9H15V3ZM12 4V8H14V4ZM7 13H17V19H7Z"
                                          Width="14" Height="14" />
                            </Button>
                            <Border Width="1" Background="{DynamicResource DividerColor}" Margin="0,4" />
                            <Button x:Name="BtnHelp" Classes="icon-btn"
                                    ToolTip.Tip="Help"
                                    Click="OnOpenHelp">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 19H11V17H13V19ZM15.07 11.25L14.17 12.17C13.45 12.9 13 13.5 13 15H11V14.5C11 13.4 11.45 12.4 12.17 11.67L13.41 10.41C13.78 10.05 14 9.55 14 9C14 7.9 13.1 7 12 7C10.9 7 10 7.9 10 9H8C8 6.79 9.79 5 12 5C14.21 5 16 6.79 16 9C16 9.88 15.64 10.68 15.07 11.25Z"
                                          Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MDI Container, with the advice banner floating over its top edge.
                     Docking the banner would resize the terminals underneath, so every
                     error would shove the console text around; overlaying leaves the
                     grid untouched. -->
                <Grid x:Name="MdiArea">
                    <ctl:DockHost x:Name="MdiHost"
                                  Background="Transparent" ClipToBounds="True" />

                    <!-- Advice banner: known CLI errors and the auto-compact hint -->
                    <Border x:Name="InfoBanner" IsVisible="False" ZIndex="10"
                            VerticalAlignment="Top" Margin="8,8,8,0"
                            CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource ToolBarBg}"
                            BorderBrush="{DynamicResource DividerColor}"
                            BoxShadow="0 4 14 0 #66000000">
                        <Border x:Name="BannerTint" Padding="12,8" CornerRadius="5">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border x:Name="BannerAccent" Grid.Column="0" Width="3" CornerRadius="2"
                                        Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BannerTitle" Text="" FontSize="12"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BannerDetail" Text="" FontSize="11"
                                               Foreground="{DynamicResource SubtleText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BtnBannerAction" Grid.Column="2" Classes="primary"
                                        Padding="10,3" Margin="8,0,4,0" IsVisible="False"
                                        VerticalAlignment="Center" Click="OnBannerAction">
                                    <TextBlock x:Name="LblBannerAction" Text="" FontSize="11" />
                                </Button>
                                <Button x:Name="BtnBannerDismiss" Grid.Column="3" Classes="icon-btn"
                                        Padding="4" VerticalAlignment="Center"
                                        ToolTip.Tip="Dismiss" Click="OnBannerDismiss">
                                    <PathIcon Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12Z"
                                              Width="12" Height="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>

    <!-- Update notice. Bottom-left and clear of the status bar, so a session stays readable
         while it is up. Raised only by the primary shell - see AppShell.Update.cs. -->
    <Border x:Name="UpdateBanner" IsVisible="False" ZIndex="20" Width="360"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,38"
            CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource ToolBarBg}"
            BorderBrush="{DynamicResource DividerColor}"
            BoxShadow="0 4 14 0 #66000000">
        <StackPanel Margin="14,12" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="UpdateTitleText" Grid.Column="0"
                           Text="A new version is available"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button x:Name="BtnUpdateDismiss" Grid.Column="1" Classes="icon-btn" Padding="4"
                        VerticalAlignment="Top" ToolTip.Tip="Dismiss" Click="OnUpdateCancel">
                    <PathIcon Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12Z"
                              Width="10" Height="10" />
                </Button>
            </Grid>
            <TextBlock x:Name="UpdateVersionText" Text="" FontSize="11"
                       Foreground="{DynamicResource SubtleText}" />
            <!-- The notes are GitHub Markdown, so they are built as controls rather than set
                 as text - see RenderUpdateNotes in AppShell.Update.cs. -->
            <ScrollViewer x:Name="UpdateNotesScroll" MaxHeight="120"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="UpdateNotes" />
            </ScrollViewer>
            <Button x:Name="BtnUpdateNotesLink" Classes="icon-btn" Padding="0,2"
                    HorizontalAlignment="Left" Click="OnUpdateNotesLink">
                <TextBlock x:Name="LblUpdateNotesLink" Text="View release notes"
                           FontSize="11" Foreground="{DynamicResource AccentText}" />
            </Button>
            <ProgressBar x:Name="UpdateProgress" IsVisible="False" Height="4"
                         Minimum="0" Maximum="100" Margin="0,2,0,0" />
            <TextBlock x:Name="UpdateProgressText" IsVisible="False" Text="" FontSize="11"
                       Foreground="{DynamicResource SubtleText}" />
            <TextBlock x:Name="UpdateError" IsVisible="False" Text="" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource DangerText}" />
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="BtnUpdateCancel" Padding="12,5" Click="OnUpdateCancel">
                    <TextBlock x:Name="LblUpdateCancel" Text="Cancel" FontSize="12" />
                </Button>
                <Button x:Name="BtnUpdateApply" Classes="primary" Padding="12,5" Click="OnUpdateApply">
                    <TextBlock x:Name="LblUpdateApply" Text="Update" FontSize="12" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Above everything, for the ghost of a tab being dragged and the strip caret. -->
    <Canvas x:Name="DragOverlay" IsHitTestVisible="False" />
    </Grid>
</UserControl>
